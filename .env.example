# Copy to .env (never commit .env). Keys stay on the proxy and are never sent to the browser.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint (OpenAI, Mistral, Together, a local vLLM/Ollama server, …)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini
PROXY_PORT=8787
