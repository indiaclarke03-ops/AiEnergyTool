{
  "version": "2026-10-19",
  "assumptions": [
    {
      "id": "lever.caching.prefill_multiplier",
      "label": "Prefill energy multiplier with shorter prompts / context caching",
      "unit": "multiplier",
      "value": {
        "low": 0.1,
        "central": 0.4,
        "high": 0.7
      },
      "notes": "Spec range −30% to −90% prefill energy.",
      "sources": [
        {
          "title": "TokenPowerBench — batch size and FP8 effects on energy per token",
          "url": "https://arxiv.org/html/2512.03024v1"
        }
      ],
      "verified": false
    },
    {
      "id": "lever.batching.multiplier",
      "label": "Energy-per-token multiplier from continuous batching / higher utilization",
      "unit": "multiplier",
      "value": {
        "low": 0.25,
        "central": 0.35,
        "high": 0.5
      },
      "notes": "Measured relative to low-batch serving. Default e_out values are calibrated to production (already batched) deployments, so this lever may overstate gains against the baseline.",
      "sources": [
        {
          "title": "TokenPowerBench — batch size and FP8 effects on energy per token",
          "url": "https://arxiv.org/html/2512.03024v1"
        },
        {
          "title": "Spheron (2026) — AI inference power & electricity cost",
          "url": "https://www.spheron.network/blog/ai-inference-power-electricity-cost-2026"
        }
      ],
      "verified": false
    },
    {
      "id": "lever.fp8.multiplier",
      "label": "Energy-per-token multiplier from FP8 quantization",
      "unit": "multiplier",
      "value": {
        "low": 0.7,
        "central": 0.735,
        "high": 0.77
      },
      "sources": [
        {
          "title": "TokenPowerBench — batch size and FP8 effects on energy per token",
          "url": "https://arxiv.org/html/2512.03024v1"
        },
        {
          "title": "Spheron (2026) — AI inference power & electricity cost",
          "url": "https://www.spheron.network/blog/ai-inference-power-electricity-cost-2026"
        }
      ],
      "verified": false
    },
    {
      "id": "lever.cooling.pue",
      "label": "PUE with liquid cooling",
      "unit": "ratio",
