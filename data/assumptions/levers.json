        }
      ],
      "verified": false
    },
    {
      "id": "lever.lifespan.it_years",
      "label": "Extended IT equipment lifespan",
      "unit": "years",
      "value": {
        "low": 6,
        "central": 7,
        "high": 8
      },
      "notes": "Lower annual capex; embodied carbon spread over more years.",
      "sources": [
        {
          "title": "Epoch AI (May 2026) — Total cost of ownership of a one-gigawatt AI data center",
          "url": "https://epoch.ai/data-insights/ai-datacenter-cost-breakdown"
