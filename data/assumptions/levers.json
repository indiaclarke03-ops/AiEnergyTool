        "user"
      ],
      "metrics": [
        "energy",
        "carbon",
        "water",
        "cost"
      ],
      "kind": "reasoning_off",
      "sources": [
        {
          "title": "Joule (2026) — Energy use of AI inference, efficiency pathways, and test-time scaling",
